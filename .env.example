# Copy to .env and adjust. Both PM2 processes read this file.

# --- Open Plant Book (species search + ideal ranges) ---
# Free key: sign up at https://open.plantbook.io, then "API keys" -> generate a token.
PLANTBOOK_API_KEY=

# --- Web dashboard ---
HOST=0.0.0.0
PORT=3000
# Public link used in notifications (optional), e.g. http://raspberrypi.local:3000
DASHBOARD_URL=

# --- Collector ---
# Default read interval in minutes (can be changed on the setup page).
READ_INTERVAL_MINUTES=20
# How long each passive scan listens for advertisements.
SCAN_SECONDS=90
# Active polling (older firmware / daily battery read).
CONNECT_TIMEOUT_MS=15000
GATT_TIMEOUT_MS=10000
POLL_ATTEMPTS=3
BATTERY_READ_HOURS=24
# Bluetooth adapter number if not hci0 (read by noble).
# NOBLE_HCI_DEVICE_ID=0

# --- Storage ---
DB_PATH=data/plants.db

# --- Alerts (optional; leave all channels empty to disable) ---
# ntfy: full topic URL. Pick a hard-to-guess topic name; anyone who knows it can read it.
NTFY_URL=
# NTFY_TOKEN=
# Generic JSON webhook, e.g. a Slack incoming webhook URL. Body: {"text": "..."}
WEBHOOK_URL=
# Email via Resend (https://resend.com). RESEND_FROM must use a domain verified in Resend
# (onboarding@resend.dev works for testing, but only delivers to your own Resend account email).
RESEND_API_KEY=
RESEND_FROM=Plant Monitor <plants@example.com>
# One or more recipients, comma-separated.
RESEND_TO=
# Email is a daily digest of all new problems, sent at this local time (24 h, the Pi's time zone).
RESEND_DIGEST_TIME=08:00
# Minutes a value must stay out of range before an alert (can be changed on the setup page).
ALERT_AFTER_MINUTES=120
# Also send a message when a problem is resolved.
ALERT_SEND_RESOLVED=false
# ntfy/webhook alerts that become due in this window are held and sent together when it ends
# (local time, may cross midnight; "off" to disable). Can be changed on the setup page.
QUIET_HOURS=21:00-08:00
# Winter season (MM-DD..MM-DD, end not included; "off" to disable). Can be changed on the setup page.
# Houseplants rest while days are short: no "Needs fertilizer" alerts (don't feed in winter), and light
# only counts as too low below WINTER_LIGHT_FACTOR x the plant's minimum. The default fits Estonia:
# October to the end of February, feeding resumes in March.
WINTER_SEASON=10-01..03-01
WINTER_LIGHT_FACTOR=0.3

# Verbose logging
# DEBUG_LOG=true
